# =============================================================================
# nexo-social — Variáveis de ambiente
# Copie para .env.local e preencha com as credenciais do seu projeto Supabase.
# Sem estas variáveis, o app roda em "modo demonstração" (dados do seed local).
# =============================================================================

# URL do projeto Supabase (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave pública (anon) — segura para o navegador
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key

# Chave de service role — SOMENTE no servidor (nunca exponha no cliente).
# Usada pelo endpoint /api/seed para popular o banco ignorando o RLS.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# =============================================================================
# Integrações externas (opcionais) — veja o passo a passo em docs/integracoes.md
# Todas são SOMENTE de servidor: não use o prefixo NEXT_PUBLIC_ nelas.
# Sem estas chaves o app continua funcionando com o catálogo próprio + links de
# busca nas plataformas parceiras.
# =============================================================================

# Spotify (developer.spotify.com/dashboard) — músicas e artistas
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Last.fm (last.fm/api/account/create) — artistas similares
LASTFM_API_KEY=

# YouTube Data API v3 (console.cloud.google.com) — vídeos. Cota: 10.000/dia
YOUTUBE_API_KEY=

# Ticketmaster Discovery (developer.ticketmaster.com) — eventos reais
TICKETMASTER_API_KEY=

# Bandsintown (exige autorização para uso comercial) — shows por artista
BANDSINTOWN_APP_ID=

# Sympla (sympla.com.br → Minha conta → Integrações) — SEUS eventos
SYMPLA_API_TOKEN=

# Eventbrite (eventbrite.com/platform/api-keys) — SEUS eventos
EVENTBRITE_TOKEN=

# =============================================================================
# Bilheteria própria — venda de ingresso DENTRO da plataforma
# =============================================================================
# Ingresso GRATUITO funciona sem nada disto: o pedido é confirmado na hora.
# As variáveis abaixo só são necessárias para cobrar ingresso pago (PIX).

# Access Token do Mercado Pago (mercadopago.com.br → Suas integrações →
# Credenciais). Use APP_USR-… em produção e TEST-… para testar sem cobrar.
MERCADOPAGO_ACCESS_TOKEN=

# Segredo da assinatura do webhook (Suas integrações → Webhooks → Configurar).
# Opcional: sem ele o aviso ainda é conferido, porque a situação do pagamento é
# sempre consultada na API do Mercado Pago em vez de lida do corpo do POST.
MERCADOPAGO_WEBHOOK_SECRET=

# URL pública do site — entra no notification_url que o Mercado Pago chama.
# Na Vercel, VERCEL_URL já resolve; defina só se usar domínio próprio.
NEXT_PUBLIC_SITE_URL=
